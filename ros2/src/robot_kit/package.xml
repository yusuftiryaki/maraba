<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_kit</name>
  <version>0.1.0</version>
  <description>
    The kit socket (docs/kit-soketi.md): detects the orchadOS scan kit, reads
    its identity chip, publishes its calibration as TF, reads its ZED-F9P,
    feeds it NTRIP corrections and chooses which GPS the robot localizes with.
  </description>
  <maintainer email="enesis@entes.com.tr">Enes</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- trunk_localizer: the site's trees, the detections message, /fromLLArray -->
  <exec_depend>robot_missions</exec_depend>
  <exec_depend>robot_missions_interfaces</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- the presence pin on the Pi; imported only there (hw.GpioPresence) -->
  <exec_depend>python3-libgpiod</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
